# Netlify _redirects file for Comics United permalinks
# This file provides fallback redirect rules

# Clean permalink patterns
/comedian/*     /index.html   200
/venue/*        /index.html   200  
/group/*        /index.html   200
/profile/*      /index.html   200
/auth           /index.html   200
